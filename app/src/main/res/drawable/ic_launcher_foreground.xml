<?xml version="1.0" encoding="utf-8"?>
<!-- A drop of glass with a light on its rim and a cursor inside it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The glass body: clear at the bottom, frosted toward the top. -->
    <path android:pathData="M31,54 A23,23 0 1,1 77,54 A23,23 0 1,1 31,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="31"
                android:endX="54"
                android:endY="77">
                <item android:offset="0" android:color="#66FFFFFF" />
                <item android:offset="1" android:color="#1AFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Its rim. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M31,54 A23,23 0 1,1 77,54 A23,23 0 1,1 31,54 Z" />
    <!-- The light caught on the upper left of the rim. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F2FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M37.5,46 A18,18 0 0,1 49,36.6" />
    <!-- The cursor, a block as in a terminal. -->
    <path
        android:fillColor="#FFF4F1FF"
        android:pathData="M50.5,45 h6 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 h-6 a2,2 0 0 1 -2,-2 v-14 a2,2 0 0 1 2,-2 z" />
</vector>
